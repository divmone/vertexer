body
{
	width: 100%;
	height: 100%;
	margin: 0px;
	padding: 0px;
	font-family: LatoLatin;
	font-size: 14px;
	color: #dbe7f8;
	background: #0b1220;
}

#desktop
{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background: #0b1220;
}

#header
{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 52px;
	background: #14213a;
	border-bottom: 1px solid #2c4570;
}

#header-title
{
	position: absolute;
	left: 20px;
	top: 10px;
	font-size: 24px;
	color: #eaf2ff;
}

#header-subtitle
{
	position: absolute;
	right: 20px;
	top: 20px;
	font-size: 13px;
	color: #7f9bc4;
}

.window
{
	position: absolute;
	width: 43%;
	height: 38%;
	background: #121c30;
	border: 1px solid #31517f;
	border-radius: 10px;
}

.window-a
{
	left: 3%;
	top: 12%;
}

.window-b
{
	left: 54%;
	top: 12%;
}

.window-c
{
	left: 3%;
	top: 55%;
}

.window-d
{
	left: 54%;
	top: 55%;
}

.window-title
{
	position: absolute;
	left: 12px;
	top: 8px;
	width: 90%;
	height: 24px;
	font-size: 14px;
	color: #9fc0ec;
}

.window-content
{
	position: absolute;
	left: 10px;
	top: 40px;
	width: 94%;
	height: 78%;
	background: #05080f;
	border: 1px solid #223a5e;
	border-radius: 6px;
}

.window-content img
{
	width: 100%;
	height: 100%;
}
