body
{
	width: 100%;
	height: 100%;
	margin: 0px;
	padding: 0px;
	font-family: LatoLatin;
	font-size: 14px;
	color: #dbe7f8;
	background: #0b1220;
}

#desktop
{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background: #0b1220;
}

#header
{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 52px;
	background: #14213a;
	border-bottom: 1px solid #2c4570;
}

#header-title
{
	position: absolute;
	left: 20px;
	top: 10px;
	font-size: 24px;
	color: #eaf2ff;
}

#header-subtitle
{
	position: absolute;
	right: 20px;
	top: 20px;
	font-size: 13px;
	color: #7f9bc4;
}

.window
{
	position: absolute;
	width: 43%;
	height: 38%;
	background: #121c30;
	border: 1px solid #31517f;
	border-radius: 10px;
}

.window-a
{
	left: 3%;
	top: 12%;
}

.window-b
{
	left: 54%;
	top: 12%;
}

.window-c
{
	left: 3%;
	top: 55%;
}

.window-d
{
	left: 54%;
	top: 55%;
}

.window-title
{
	position: absolute;
	left: 12px;
	top: 8px;
	width: 90%;
	height: 24px;
	font-size: 14px;
	color: #9fc0ec;
}

.window-content
{
	position: absolute;
	left: 10px;
	top: 40px;
	width: 94%;
	height: 78%;
	background: #05080f;
	border: 1px solid #223a5e;
	border-radius: 6px;
}

.toolbar-button
{
	position: absolute;
	left: 10px;
	top: 8px;
	width: 140px;
	height: 28px;
	background: #1d3357;
	border: 1px solid #3c5f96;
	border-radius: 6px;
	color: #dbe7f8;
	font-size: 13px;
	text-align: center;
}

.toolbar-button:hover
{
	background: #27456f;
}

.toolbar-button:active
{
	background: #16263f;
}

.image-status
{
	position: absolute;
	left: 160px;
	right: 10px;
	top: 14px;
	height: 18px;
	font-size: 12px;
	color: #7f9bc4;
	overflow: hidden;
}

.image-frame
{
	position: absolute;
	left: 10px;
	right: 10px;
	top: 44px;
	bottom: 10px;
	background: #0a1526;
	border: 1px solid #223a5e;
	border-radius: 4px;
	overflow: hidden;
}

.image-preview
{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
}

.image-placeholder
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 45%;
	height: 20px;
	text-align: center;
	font-size: 13px;
	color: #4f6c94;
}
